Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"create", " ", "network"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"mytrainednet", "=", 
   RowBox[{"NetChain", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ElementwiseLayer", "[", "LogisticSigmoid", "]"}], ",", 
      RowBox[{"LinearLayer", "[", 
       RowBox[{"8", ",", 
        RowBox[{"\"\<Input\>\"", "\[Rule]", "4"}], ",", 
        RowBox[{"\"\<Weights\>\"", "\[Rule]", "weightslayer1"}], ",", 
        RowBox[{"\"\<Biases\>\"", "\[Rule]", "biaseslayer1"}]}], "]"}], ",", 
      RowBox[{"ElementwiseLayer", "[", "LogisticSigmoid", "]"}], ",", 
      RowBox[{"LinearLayer", "[", 
       RowBox[{"101", ",", 
        RowBox[{"\"\<Input\>\"", "\[Rule]", "8"}], ",", 
        RowBox[{"\"\<Weights\>\"", "\[Rule]", "weightslayer2"}], ",", 
        RowBox[{"\"\<Biases\>\"", "\[Rule]", "biaseslayer2"}]}], "]"}]}], 
     "}"}], "]"}]}]}]], "Input",
