Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "scale", " ", "input", " ", "data", " ", "and", " ", "make", " ", 
    "predictions"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"scale", "[", 
      RowBox[{"x_", ",", "min_", ",", "max_"}], "]"}], ":=", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", "min"}], ")"}], "*", 
        RowBox[{"0.9", "/", 
         RowBox[{"(", 
          RowBox[{"max", "-", "min"}], ")"}]}]}], "+", "0.05"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", "scaledinput", "}"}], "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{"scale", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "newmolinputs", "}"}], ",", 
         RowBox[{"{", "inmin", "}"}], ",", 
         RowBox[{"{", "inmax", "}"}]}], "}"}]}], "]"}]}], ";", 
    RowBox[{"predictions", "=", 
     RowBox[{"mytrainednet", "[", "scaledinput", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"unscale", " ", "output", " ", "data"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"unscale", "[", 
      RowBox[{"y_", ",", "min_", ",", "max_"}], "]"}], ":=", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"y", "-", "0.05"}], ")"}], "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"max", "-", "min"}], ")"}], "/", "0.9"}]}], "+", "min"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"unscaledpredictions", "=", 
     RowBox[{
      RowBox[{"MapThread", "[", 
       RowBox[{"unscale", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "predictions", "}"}], ",", 
          RowBox[{"{", "outmin", "}"}], ",", 
          RowBox[{"{", "outmax", "}"}]}], "}"}]}], "]"}], "//", "Flatten"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"energygrid", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"i", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "25.0", ",", "100.0", ",", "0.75"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"outputdata", "=", 
     RowBox[{"Thread", "[", 
      RowBox[{"{", 
       RowBox[{"energygrid", ",", "unscaledpredictions"}], "}"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"output", " ", "prediction", " ", "to", " ", "file"}], " ", 
